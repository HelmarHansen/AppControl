<Window x:Class="AppControl.Host.Ui.ConsentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppControl — Zugriffsanfrage"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True"
        ShowInTaskbar="True" Background="#0F172A">

    <!--
      Der Consent-Dialog. Sieben Details verhindern hier je einen konkreten
      Angriff oder Unfall - siehe docs/03-consent-and-transparency.md §3.2:

        - Fokus liegt auf "Ablehnen"  → Enter/Leertaste geben nicht frei
        - "Nur zusehen" vorausgewählt → Steuerung wird nie beiläufig mitvergeben
        - "Freigeben" deaktiviert     → kein Klick ohne Entscheidung über den Scope
        - 60-Sekunden-Timeout          → ein übersehener Dialog gibt nie von selbst frei
        - SAS-Emojis                   → Man-in-the-Middle wird sichtbar
        - Fingerprint-Status           → ein neuer Schlüssel unter bekanntem Namen fällt auf
        - Auto-Stopp-Dauer             → keine vergessenen Endlos-Sitzungen
    -->

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Kopf -->
            <RowDefinition Height="Auto"/> <!-- Identität + SAS -->
            <RowDefinition Height="Auto"/> <!-- Was freigeben -->
            <RowDefinition Height="Auto"/> <!-- Steuerung -->
            <RowDefinition Height="Auto"/> <!-- Dauer -->
            <RowDefinition Height="Auto"/> <!-- Aktionen -->
        </Grid.RowDefinitions>

        <!-- ── Kopf ─────────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="🔴  Zugriffsanfrage" FontSize="21" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="RequesterText" FontSize="15" Foreground="#CBD5E1" Margin="0,8,0,0"
                       TextWrapping="Wrap" Text="… möchte deinen Bildschirm sehen"/>
        </StackPanel>

        <!-- ── Identität und SAS ────────────────────────────────────────── -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="16" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="SICHERHEITSCODE" FontSize="10" FontWeight="Bold"
                           Foreground="#94A3B8" Margin="0,0,0,6"/>
                <TextBlock x:Name="SasText" FontSize="30" Foreground="White"
                           Text="🐙 🍒 🚀 🔔 🎩" Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#FCD34D"
                           Text="⚠️  Vergleicht diese Symbole per Telefon oder Chat. Nur wenn sie auf beiden Seiten übereinstimmen, ist die Verbindung sicher."/>

                <CheckBox x:Name="SasConfirmed" Margin="0,12,0,0" Foreground="#E2E8F0" FontSize="12"
                          Content="Die Symbole stimmen mit dem überein, was mein Gegenüber sieht"
                          Checked="OnSelectionChanged" Unchecked="OnSelectionChanged"/>

                <Separator Margin="0,12" Background="#334155"/>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Schlüssel:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FingerprintText" FontFamily="Consolas" FontSize="11"
                               Foreground="#CBD5E1" Margin="6,0" VerticalAlignment="Center"/>
                    <Border x:Name="TrustBadge" CornerRadius="3" Padding="6,1" Background="#166534">
                        <TextBlock x:Name="TrustText" Text="✓ bekannt" FontSize="10"
                                   Foreground="White" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <Border x:Name="TrustWarning" Background="#7F1D1D" CornerRadius="6" Padding="12"
                        Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="TrustWarningText" TextWrapping="Wrap" FontSize="12" Foreground="#FECACA"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- ── Was freigeben ────────────────────────────────────────────── -->
        <StackPanel Grid.Row="2" Margin="0,0,0,18">
            <TextBlock Text="WAS MÖCHTEST DU FREIGEBEN?" FontSize="10" FontWeight="Bold"
                       Foreground="#94A3B8" Margin="0,0,0,8"/>

            <RadioButton x:Name="ScopeScreenRadio" GroupName="Scope" Foreground="#E2E8F0"
                         Margin="0,4" Checked="OnScopeKindChanged">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Gesamter Bildschirm" VerticalAlignment="Center"/>
                    <ComboBox x:Name="MonitorCombo" Width="180" Margin="10,0,0,0"
                              SelectionChanged="OnSelectionChanged"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="ScopeWindowRadio" GroupName="Scope" Foreground="#E2E8F0"
                         Margin="0,4" Checked="OnScopeKindChanged">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Nur eine Anwendung" VerticalAlignment="Center"/>
                    <Button x:Name="PickAppButton" Content="Auswählen …" Margin="10,0,0,0"
                            Padding="10,3" Click="OnPickApp"/>
                    <TextBlock x:Name="PickedAppText" Foreground="#7DD3FC" Margin="10,0,0,0"
                               VerticalAlignment="Center" MaxWidth="200"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <!-- ── Steuerung ────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="3" Margin="0,0,0,18">
            <TextBlock x:Name="ControlHeader" Text="DARF … STEUERN?" FontSize="10" FontWeight="Bold"
                       Foreground="#94A3B8" Margin="0,0,0,8"/>

            <!-- IsChecked=True: Der sichere Fall ist der vorausgewählte. -->
            <RadioButton x:Name="ControlNoRadio" GroupName="Control" IsChecked="True"
                         Content="Nein — nur zusehen" Foreground="#E2E8F0" Margin="0,4"
                         Checked="OnSelectionChanged"/>

            <RadioButton x:Name="ControlYesRadio" GroupName="Control" Foreground="#E2E8F0" Margin="0,4"
                         Checked="OnSelectionChanged">
                <StackPanel>
                    <TextBlock Text="Ja — Maus und Tastatur erlauben"/>
                    <TextBlock x:Name="ControlWarningText" FontSize="11" Foreground="#FCA5A5"
                               TextWrapping="Wrap" Margin="0,3,0,0"
                               Text="⚠️ Dein Gegenüber kann dann in diesem Bereich alles tun, was du tun kannst."/>
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <!-- ── Dauer ────────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Automatisch beenden nach:" Foreground="#CBD5E1"
                       VerticalAlignment="Center" FontSize="12"/>
            <ComboBox x:Name="DurationCombo" Width="140" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- ── Aktionen ─────────────────────────────────────────────────── -->
        <Grid Grid.Row="5">
            <TextBlock x:Name="CountdownText" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Foreground="#94A3B8" FontSize="12" Text="Anfrage läuft ab in 1:00"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- IsDefault UND IsCancel auf "Ablehnen": Enter und Escape lehnen ab. -->
                <Button x:Name="DenyButton" Content="Ablehnen" Padding="22,9" Margin="0,0,10,0"
                        IsCancel="True" IsDefault="True" Click="OnDeny" FontWeight="SemiBold"/>
                <Button x:Name="GrantButton" Content="Freigeben" Padding="22,9"
                        IsEnabled="False" Click="OnGrant" FontWeight="Bold"
                        Background="#DC2626" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

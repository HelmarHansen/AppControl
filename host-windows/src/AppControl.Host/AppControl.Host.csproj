<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>

    <!--
      Der Target-Framework-Moniker ist hier die zentrale Entscheidung:
      Das Suffix "-windows10.0.19041.0" aktiviert C#/WinRT-Interop und macht damit
      Windows.Graphics.Capture direkt aus WPF heraus nutzbar - ohne WinUI, ohne
      MSIX-Paketierung, ohne Wrapper-Bibliothek. Siehe docs/02-tech-stack.md §2.3.
    -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>

    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>   <!-- nur fuer NotifyIcon (Tray) -->
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>AppControl.Host</RootNamespace>
    <AssemblyName>AppControl</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>   <!-- Frame-Zugriff ohne Kopie -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!--
      NuGet-Sicherheitsaudit als Fehler, nicht als Warnung. Ohne das laeuft eine
      Abhaengigkeit mit bekannter Luecke stillschweigend mit - genau das ist beim
      ersten CI-Lauf dieses Projekts passiert (SIPSorcery 8.0.11, DoS ueber
      manipulierte UDP-Pakete auf dem RTP-Socket).
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <ItemGroup>
    <!--
      WebRTC: rein verwaltet, kein natives Build noetig. Siehe docs/02-tech-stack.md §2.5

      MINDESTVERSION 10.0.9 IST EINE SICHERHEITSANFORDERUNG, KEINE KOSMETIK:
      Aeltere Versionen sind fuer GHSA-28gm-jrmw-xx93 anfaellig - ein manipuliertes
      UDP-Paket auf dem RTP/ICE-Socket beendet die Medien-Sitzung aus der Ferne.
      Genau dieser Socket ist bei AppControl zum Internet offen, weil P2P der
      Normalfall ist. Nicht heruntersetzen.
    -->
    <PackageReference Include="SIPSorcery" Version="10.0.13" />

    <!-- Krypto: duenner Wrapper ueber libsodium. Gegenstueck zu swift-crypto im Viewer. -->
    <PackageReference Include="NSec.Cryptography" Version="26.4.0" />

    <!--
      KEINE Wrapper-Bibliothek fuer Direct3D und Media Foundation.

      Capture/D3D11Helper.cs und Encoding/MediaFoundationH264Encoder.cs sprechen
      direkt per P/Invoke und COM-Interop mit den nativen APIs. Die Alternative
      waere Vortice.* gewesen; dagegen sprach, dass es hier um wenige Dutzend
      Aufrufe geht, deren native Signaturen stabil und gut dokumentiert sind.
      Eine Abhaengigkeit von ~30 MB fuer drei Funktionen lohnt sich nicht - und
      bei Interop ist es ohnehin hilfreich, genau zu sehen, was ueber die Grenze
      geht.
    -->

    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.18" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.18" />
    <PackageReference Include="System.Text.Json" Version="9.0.18" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
